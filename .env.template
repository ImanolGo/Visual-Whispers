# Required: one OpenRouter key runs everything. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Who looks at the pictures (any OpenRouter model with image input)
DESCRIBE_MODEL=anthropic/claude-haiku-5.5

# Who paints: auto | replicate | openrouter
#   auto uses Replicate Flux Schnell when REPLICATE_API_TOKEN is set (fastest, ~1-2 s),
#   otherwise an OpenRouter image model, so the OpenRouter key alone is enough.
IMAGE_PROVIDER=auto
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# Only needed for `docker compose --profile share up` (public link via ngrok)
NGROK_AUTHTOKEN=

# Offline demo with fake models (no keys, no cost)
# MOCK_PROVIDERS=1
